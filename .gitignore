# regenerated on every cardlayout probe run — evidence artifact, not source
apps/desktop/renderer/tests/gear-browser-evidence.png
apps/desktop/renderer/tests/minihire-browser-evidence.png

# private worktrees and local release output — never part of the source tree
.worktrees/
artifacts/

# intermediate iconset PNGs, regenerated by tools/generate-icon.mjs each run
apps/desktop/assets/orgtree-eye.iconset/
# Litter from tests/attach.test.mjs if a run dies before its cleanup hook.
# The fixtures now live under %LOCALAPPDATA%, so this should never match --
# it is the belt to that cleanup braces, because the failure mode is an agent
# sweeping stray fixture dirs into a commit with `git add -A` and not noticing.
acl-fixtures-*/
