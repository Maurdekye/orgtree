{
  "format": "orgtree-app",
  "version": 1,
  "definition": {
    "name": "Annotation notes",
    "description": "A small portable editor with independent saved JSON and permission-checked local-agent delivery.",
    "html": "<!doctype html><html><head><meta charset=\"utf-8\"><style>\nbody{font:14px system-ui;background:#f6f8fd;color:#24324a;margin:0;padding:18px}h1{font-size:19px;margin:0 0 12px}label{display:block;margin:10px 0}input,textarea{display:block;box-sizing:border-box;width:100%;padding:8px;border:1px solid #acb8cc;border-radius:5px;font:inherit}textarea{min-height:140px;resize:vertical}button{padding:8px 12px;margin:4px 4px 0 0;border:1px solid #7889a7;border-radius:5px;background:white;color:inherit}#status{min-height:20px;font-size:12px;white-space:pre-wrap}\n</style></head><body><h1>Annotation notes</h1><p>Each saved panel keeps independent JSON. Send passes your text to a local agent after Orgtree checks permission.</p><label>Local agent<input id=\"to\" autocomplete=\"off\"></label><label>Notes<textarea id=\"note\"></textarea></label><button id=\"save\">Save notes</button><button id=\"load\">Reload saved data</button><button id=\"send\">Send to agent</button><p id=\"status\" role=\"status\">Loading saved data…</p><script>\nconst to=document.querySelector('#to'),note=document.querySelector('#note'),status=document.querySelector('#status');let busy=false;\nasync function run(fn){if(busy)return;busy=true;for(const b of document.querySelectorAll('button'))b.disabled=true;try{await fn()}catch(e){status.textContent=e.message}finally{busy=false;for(const b of document.querySelectorAll('button'))b.disabled=false}}\nasync function load(){const s=await orgtree.state.get();to.value=typeof s.to==='string'?s.to:'';note.value=typeof s.note==='string'?s.note:'';status.textContent='Saved data loaded'}\nasync function save(){await orgtree.state.set({to:to.value.trim().replace(/^@/,''),note:note.value});status.textContent='Notes saved'}\ndocument.querySelector('#save').onclick=()=>run(save);document.querySelector('#load').onclick=()=>run(load);document.querySelector('#send').onclick=()=>run(async()=>{const target=to.value.trim().replace(/^@/,'');if(!target||!note.value.trim())throw Error('Enter a local agent and some notes.');await save();await orgtree.call('mail.send',{to:target,body:note.value});status.textContent='Sent as app content to '+target});run(load);\n</script></body></html>",
    "initial_state": {
      "to": "",
      "note": ""
    },
    "capabilities": [
      "mail.send"
    ],
    "width": 480,
    "height": 560
  },
  "panels": []
}
