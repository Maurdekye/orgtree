{
  "name": "orgtree",
  "version": "2.0.0-alpha.6",
  "private": true,
  "description": "Orgtree desktop application",
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "package:dir": "npm run build && node tools/package-preflight.mjs && electron-builder --dir",
    "package:win": "npm run build && node tools/package-preflight.mjs && electron-builder --win nsis",
    "test:electron": "node tools/test-electron.mjs",
    "runtime:provision": "python tools/provision-runtime.py"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@jridgewell/trace-mapping": "^0.3.28",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "electron-updater": "^6.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "jsdom": "^30.0.1",
    "@types/jsdom": "^28.0.3"
  },
  "build": {
    "appId": "com.maurdekye.orgtree",
    "productName": "Orgtree",
    "directories": { "output": "release" },
    "icon": "apps/desktop/assets/orgtree-eye.ico",
    "files": ["dist/**/*", "apps/desktop/assets/**/*", "package.json", "LICENSE"],
    "extraResources": [{ "from": "engine", "to": "engine", "filter": ["**/*", "!**/__pycache__/**"] }, { "from": "dist/renderer", "to": "ui" }, { "from": "dist/build-info.json", "to": "build-info.json" }, { "from": "apps/desktop/assets", "to": "runtime-icons", "filter": ["orgtree-eye*.ico"] }],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false, "createStartMenuShortcut": true, "shortcutName": "Orgtree", "menuCategory": "Orgtree", "include": "build/installer.nsh" },
    "publish": [{ "provider": "github", "owner": "Maurdekye", "repo": "orgtree", "releaseType": "prerelease" }]
  }
}
